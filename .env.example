# ===== Telegram =====
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# A random secret you choose. Used to authenticate the payment webhook
# (set the same value when registering the webhook via setWebhook).
TELEGRAM_BOT_SECRET_TOKEN=

# ===== Convex =====
# Deployment URL. Run `npx convex dev` and copy the URL it prints.
# This is used server-side (by the API routes) via ConvexHttpClient.
CONVEX_URL=

# Same URL, exposed to the browser client. Without it the app runs in demo mode.
NEXT_PUBLIC_CONVEX_URL=

# ===== Shared secret (Next.js <-> Convex) =====
# Pick a random value and set it in BOTH places:
#   .env.local (here)  AND  `npx convex env set API_SECRET <value>`
API_SECRET=

# ===== Admin (for the /refund command in the bot chat) =====
# Your own Telegram user id. Find it by messaging @userinfobot.
ADMIN_TG_ID=

# ===== AI Coach (DeepSeek) =====
# DeepSeek API key (one key powers both text and vision). Set it in Convex too:
#   npx convex env set DEEPSEEK_API_KEY <key> --prod
# NEVER commit a real key — this file is committed, .env.local is not.
DEEPSEEK_API_KEY=
# Optional override of the text model id (default: deepseek-v4-flash).
DEEPSEEK_MODEL=
# Optional override of the vision model id (default: deepseek-v4-flash-vision-exp).
VISION_MODEL=
