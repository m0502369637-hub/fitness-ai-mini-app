# ===== Telegram =====
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# A random secret you choose. Used to authenticate the payment webhook
# (set the same value when registering the webhook via setWebhook).
TELEGRAM_BOT_SECRET_TOKEN=

# ===== Convex =====
# Deployment URL. Run `npx convex dev` and copy the URL it prints.
# This is used server-side (by the API routes) via ConvexHttpClient.
CONVEX_URL=

# Same URL, exposed to the browser client. Without it the app runs in demo mode.
NEXT_PUBLIC_CONVEX_URL=

# ===== Shared secret (Next.js <-> Convex) =====
# Pick a random value and set it in BOTH places:
#   .env.local (here)  AND  `npx convex env set API_SECRET <value>`
API_SECRET=

# ===== Admin (for the /refund command in the bot chat) =====
# Your own Telegram user id. Find it by messaging @userinfobot.
ADMIN_TG_ID=

# ===== AI Coach (DeepSeek) =====
# DeepSeek API key (one key powers both text and vision). Set it in Convex too:
#   npx convex env set DEEPSEEK_API_KEY <key> --prod
# NEVER commit a real key — this file is committed, .env.local is not.
DEEPSEEK_API_KEY=
# Optional override of the text model id (default: deepseek-v4-flash).
DEEPSEEK_MODEL=
# Optional override of the vision model id (default: deepseek-v4-flash-vision-exp).
VISION_MODEL=

# ===== Marketing Engine (Autonomous Marketing OS — convex/marketing/) =====
# Master switch: the engine stays dormant until this is exactly "true".
MARKETING_ENABLED=
# Hugging Face Inference API token (text + image + video generation).
HF_API_TOKEN=
# Composio API key (posts to X / Facebook / Instagram / LinkedIn).
COMPOSIO_API_KEY=
# Composio connected account ids per platform (from the Composio dashboard).
COMPOSIO_CONNECTED_ACCOUNT_ID_X=
COMPOSIO_CONNECTED_ACCOUNT_ID_FACEBOOK=
COMPOSIO_CONNECTED_ACCOUNT_ID_INSTAGRAM=
COMPOSIO_CONNECTED_ACCOUNT_ID_LINKEDIN=
# Account-specific ids the Composio tools need:
COMPOSIO_FACEBOOK_PAGE_ID=
COMPOSIO_INSTAGRAM_IG_USER_ID=
COMPOSIO_LINKEDIN_AUTHOR=
# Optional overrides (defaults shown — current Composio v3 tool slugs):
# COMPOSIO_ACTION_X=TWITTER_CREATION_OF_A_POST
# COMPOSIO_ACTION_X_UPLOAD=TWITTER_UPLOAD_MEDIA
# COMPOSIO_ACTION_FACEBOOK=FACEBOOK_CREATE_PHOTO_POST
# COMPOSIO_ACTION_LINKEDIN=LINKEDIN_CREATE_LINKED_IN_POST
# COMPOSIO_ACTION_INSTAGRAM=INSTAGRAM_POST_IG_USER_MEDIA
# COMPOSIO_ACTION_INSTAGRAM_PUBLISH=INSTAGRAM_POST_IG_USER_MEDIA_PUBLISH
# COMPOSIO_ACTION_TIKTOK=TIKTOK_POST_VIDEO
# fal-ai video fallback (free key at https://fal.ai):
FAL_API_KEY=
# FAL_VIDEO_ENDPOINT=fal-ai/bytedance/seedance/v1/pro/image-to-video
# FAL_VIDEO_DURATION=5   # whole seconds (Seedance: 2-12)
# MARKETING_TEXT_MODEL=meta-llama/Llama-3.1-8B-Instruct
# MARKETING_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers
# MARKETING_VIDEO_MODEL=Lightricks/LTX-Video-0.9.7-distilled
# MARKETING_TEXT_FALLBACK=on   # "off" disables the DeepSeek fallback for captions
# MARKETING_THEME=30-day fitness transformation
# MARKETING_TOPIC=quick home workouts, no equipment
# MARKETING_BRAND_COLOR=#d7f26d
# APP_URL=https://t.me/FitAI_Training_bot
# All of the above also live in Convex: `npx convex env set NAME value --prod`.
# Full prompt documentation: convex/marketing/PROMPTS.md
